+/// Sliding-attention cache, using the same chronological-prefill/ring-decode
+/// layout as mlx-lm BatchRotatingKVCache. No pinned prefix is supported here.
+public final class BatchRotatingKVCache: BaseKVCache, BatchKVCacheProtocol {
+    public let batchSize: Int
+    public private(set) var batchOffset: MLXArray
+    private var leftPadding: MLXArray
+    private var ends: MLXArray?
+    private var keys: MLXArray?
+    private var values: MLXArray?
+    private var index = 0
+    private var rotated = false
+    private let capacity: Int
+    private let step = 256
+    package var capacityOrigin = RotatingKVCache.CapacityOrigin.modelNative
+
+    public init(maxSize: Int, leftPadding: [Int]) {
+        precondition(maxSize > 0 && maxSize <= Int(Int32.max))
+        precondition(!leftPadding.isEmpty && leftPadding.allSatisfy { (0 ... Int(Int32.max)).contains($0) })
+        capacity = maxSize; batchSize = leftPadding.count
+        self.leftPadding = MLXArray(leftPadding.map(Int32.init))
+        batchOffset = -self.leftPadding
+        super.init()
+    }
+
+    public override var maxSize: Int? { capacity }
+    public var rowPositionState: [MLXArray] { [batchOffset, leftPadding] }
+    public func logicalOffset(row: Int) throws -> Int {
+        guard (0..<batchSize).contains(row) else { throw KVCacheError(message: "Invalid cache row.") }
+        return batchOffset.asArray(Int.self)[row]
+    }
+    public override var ropeOffset: RoPEOffset { .batch(batchOffset + 0) }
+    public override func innerState() -> [MLXArray] {
+        [keys, values, batchOffset, leftPadding, ends].compactMap { $0 }
+    }
+
+    public override func prepare(lengths: [Int]?) {
+        guard let lengths else { return }
+        precondition(lengths.count == batchSize && lengths.allSatisfy { (0 ... Int(Int32.max)).contains($0) })
+        prepare(lengths: MLXArray(lengths.map(Int32.init)))
+    }
+    public override func prepare(lengths: MLXArray?) {
+        guard let lengths else { return }
+        precondition(lengths.shape == [batchSize] && ends == nil)
+        ends = batchOffset + lengths
+    }
+
+    private func ordered(_ array: MLXArray) -> MLXArray {
+        rotated ? roll(array, shift: -index, axis: 2) : array[.ellipsis, ..<index, 0...]
+    }
+
+    private func updateConcat(keys: MLXArray, values: MLXArray) -> (MLXArray, MLXArray) {
+        if let oldKeys = self.keys, let oldValues = self.values {
+            var k = ordered(oldKeys), v = ordered(oldValues)
+            if let ends {
+                let padding = maximum(batchOffset - ends, 0)
+                k = rollRows(k, by: padding); v = rollRows(v, by: padding)
+                batchOffset = batchOffset - padding; leftPadding = leftPadding + padding
+            }
+            let trim = max(0, k.dim(2) - capacity + 1)
+            self.keys = concatenated([k[.ellipsis, trim..., 0...], keys], axis: 2)
+            self.values = concatenated([v[.ellipsis, trim..., 0...], values], axis: 2)
+            leftPadding = leftPadding - trim
+        } else {
+            self.keys = keys; self.values = values
+        }
+        offset += keys.dim(2); batchOffset = batchOffset + keys.dim(2)
+        index = self.keys!.dim(2); rotated = false
+        self.keys = depends(input: self.keys!, dependencies: [batchOffset, leftPadding])
+        return (self.keys!, self.values!)
+    }
+
+    private func updateOne(keys: MLXArray, values: MLXArray) -> (MLXArray, MLXArray) {
+        let filled = self.keys?.dim(2) ?? 0
+        if self.keys == nil || (!rotated && index >= filled && filled < capacity) {
+            let growth = min(step, capacity - filled)
+            let k = MLXArray.zeros([batchSize, keys.dim(1), growth, keys.dim(3)], dtype: keys.dtype)
+            let v = MLXArray.zeros([batchSize, values.dim(1), growth, values.dim(3)], dtype: values.dtype)
+            self.keys = self.keys.map { concatenated([$0, k], axis: 2) } ?? k
+            self.values = self.values.map { concatenated([$0, v], axis: 2) } ?? v
+        }
+        let trim = max(0, self.keys!.dim(2) - capacity)
+        if trim > 0 {
+            self.keys = self.keys![.ellipsis, trim..., 0...]
+            self.values = self.values![.ellipsis, trim..., 0...]
+            index = capacity; leftPadding = leftPadding - trim
+        }
+        if index == capacity { rotated = true; index = 0 }
+        if rotated { leftPadding = leftPadding - 1 }
+        self.keys![.ellipsis, index ..< index + 1, 0...] = keys
+        self.values![.ellipsis, index ..< index + 1, 0...] = values
+        index += 1; offset += 1; batchOffset = batchOffset + 1
+        self.keys = depends(input: self.keys!, dependencies: [batchOffset, leftPadding])
+        if !rotated && index < self.keys!.dim(2) {
+            return (self.keys![.ellipsis, ..<index, 0...], self.values![.ellipsis, ..<index, 0...])
+        }
+        return (self.keys!, self.values!)
+    }
+
+    public override func update(keys: MLXArray, values: MLXArray) -> (MLXArray, MLXArray) {
+        checkBatchKV(keys, values, rows: batchSize)
+        let (next, overflow) = offset.addingReportingOverflow(keys.dim(2))
+        precondition(!overflow && next <= Int(Int32.max))
+        return keys.dim(2) == 1 && ends == nil ? updateOne(keys: keys, values: values) : updateConcat(keys: keys, values: values)
+    }
+
+    public override func makeMask(n: Int, windowSize: Int?, returnArray: Bool) -> MLXFast.ScaledDotProductAttentionMaskMode {
+        let oldCount = min(capacity - 1, offset)
+        let columns = MLXArray(Int32(0) ..< Int32(oldCount + n))[.newAxis]
+        let queries = MLXArray(Int32(oldCount) ..< Int32(oldCount + n))[0..., .newAxis]
+        var padding = leftPadding
+        if let ends { padding = padding + maximum(batchOffset - ends, 0) }
+        let concatenate = n > 1 || ends != nil
+        padding = padding - max(0, index - capacity + (concatenate ? 1 : 0))
+        let willRotate = !concatenate && (rotated || index >= capacity)
+        if willRotate { padding = padding - 1 }
+        var mask = (queries .>= columns) & (queries .< columns + (windowSize ?? capacity))
+        mask = mask & (columns .>= padding[0..., .newAxis, .newAxis, .newAxis])
+        if willRotate { mask = roll(mask, shift: (index >= capacity ? 0 : index) + 1, axis: -1) }
+        return .array(mask)
+    }
+
+    public override func finalize() {
+        guard let ends else { return }
+        let padding = maximum(batchOffset - ends, 0)
+        if let keys, let values {
+            self.keys = rollRows(ordered(keys), by: padding)
+            self.values = rollRows(ordered(values), by: padding)
+            index = self.keys!.dim(2); rotated = false
+        }
+        batchOffset = batchOffset - padding; leftPadding = leftPadding + padding
+        self.ends = nil
+    }
+
+    public override var isTrimmable: Bool { !rotated && offset < capacity }
+    public override func isTrimmable(after positions: Int) -> Bool {
+        positions >= 0 && isTrimmable && positions < capacity - offset
+    }
+    public override func trim(_ n: Int) -> Int {
+        guard isTrimmable else { return 0 }
+        let count = min(max(0, n), min(offset, index))
+        offset -= count; index -= count; batchOffset = batchOffset - count
+        return count
+    }
+
+    public override var state: [MLXArray] {
+        get {
+            guard let keys, let values else { return [] }
+            return [keys, values, batchOffset, leftPadding]
+        }
+        set {
+            precondition(newValue.count == 4 && newValue[2].shape == [batchSize] && newValue[3].shape == [batchSize])
+            checkBatchKV(newValue[0], newValue[1], rows: batchSize)
+            keys = newValue[0]; values = newValue[1]
+            batchOffset = newValue[2]; leftPadding = newValue[3]; ends = nil
+        }
+    }
+    public override var metaState: [String] {
+        get { [String(capacity), String(offset), String(index), String(rotated), capacityOrigin.rawValue] }
+        set {
+            precondition(newValue.count == 5 && Int(newValue[0]) == capacity)
+            guard let offset = Int(newValue[1]), let index = Int(newValue[2]), let rotated = Bool(newValue[3]), let origin = RotatingKVCache.CapacityOrigin(rawValue: newValue[4]) else { preconditionFailure("Invalid batch cache metadata.") }
+            self.offset = offset; self.index = index; self.rotated = rotated; capacityOrigin = origin
+        }
+    }
+
+    public override func copy() -> any KVCache {
+        let result = BatchRotatingKVCache(maxSize: capacity, leftPadding: Array(repeating: 0, count: batchSize))
+        result.keys = keys.map(copyBatchArray); result.values = values.map(copyBatchArray)
+        result.offset = offset; result.index = index; result.rotated = rotated
+        result.batchOffset = batchOffset + 0; result.leftPadding = leftPadding + 0
+        result.ends = ends.map { $0 + 0 }; result.capacityOrigin = capacityOrigin
+        return result
+    }
+
+    public func extract(row: Int, through position: Int) throws -> any KVCache {
+        let actual = try logicalOffset(row: row)
+        guard ends == nil, position >= 0, position <= actual else {
+            throw KVCacheError(message: "Extract an actually retained row prefix.")
+        }
+        let result = RotatingKVCache(maxSize: capacity)
+        result.capacityOrigin = capacityOrigin
+        guard position > 0, let keys, let values else { return result }
+        let k = ordered(keys), v = ordered(values)
+        let padding = max(0, leftPadding.asArray(Int.self)[row])
+        let available = k.dim(2) - padding
+        let first = actual - available, wanted = max(0, position - capacity)
+        guard available >= 0, first >= 0, wanted >= first else {
+            throw KVCacheError(message: "This exact native prefix was overwritten; use retained disk coverage.")
+        }
+        let start = padding + wanted - first, count = position - wanted
+        guard count > 0, start >= 0, count <= k.dim(2) - start else {
+            throw KVCacheError(message: "Invalid retained row coordinates.")
+        }
+        result.state = [copyRow(k, row: row, start: start, end: start + count),
+            copyRow(v, row: row, start: start, end: start + count)]
+        result.metaState = ["0", String(capacity), "256", String(position), String(count), capacityOrigin.rawValue, "false"]
+        return result
+    }
+
+    /// Physical ring ranges for an ACTUALLY ready row position/padding pair.
+    /// The caller reads that pair from rowPositionState on the model producer;
+    /// this method never evaluates or creates a tensor view.
+    public func residentRanges(position: Int, padding: Int, after: Int,
+        through: Int? = nil) throws -> [(Int, Range<Int>)] {
+        let filled = keys?.dim(2) ?? 0
+        let held = rotated ? filled : index
+        let invalid = max(0, padding)
+        guard (ends == nil || through != nil), position >= 0, after >= 0, invalid <= held,
+            index >= 0, index <= filled, !rotated || filled == capacity,
+            position >= held - invalid, (0...position).contains(through ?? position) else {
+            throw KVCacheError(message: "Invalid ready row geometry.")
+        }
+        guard held > 0 else { return [] }
+        var logical = position - held
+        let firstValid = logical + invalid
+        let pieces = rotated ? [index..<filled, 0..<index] : [0..<held]
+        var result: [(Int, Range<Int>)] = []
+        for piece in pieces where !piece.isEmpty {
+            let lower = max(firstValid, max(after, logical))
+            let physicalEnd = logical + piece.count
+            // During preparation a short row's right-padding and later peers'
+            // inert inputs are physical cache positions, never its source data.
+            let upper = min(physicalEnd, through ?? position)
+            if lower < upper {
+                result.append((lower, (piece.lowerBound + lower - logical)..<(piece.lowerBound + upper - logical)))
+            }
+            logical = physicalEnd
+        }
+        return result
+    }
+
+    public func extract(row: Int) throws -> any KVCache {
+        try extract(row: row, through: logicalOffset(row: row))
+    }
+}
+
+/// Merge independent scalar caches, preserving their actual absolute positions.
+/// Only homogeneous unquantized full caches or keep=0 sliding caches are admitted.
+public func mergeBatchKVCache(_ caches: [any KVCache]) throws -> any BatchKVCacheProtocol {
+    guard !caches.isEmpty else { throw KVCacheError(message: "A batch needs at least one row.") }
+    let rotating = caches.first is RotatingKVCache
+    let capacity = caches.first?.maxSize
+    var rows: [(MLXArray, MLXArray)?] = []
+    for cache in caches {
+        guard cache.offset >= 0 && cache.offset <= Int(Int32.max) else { throw KVCacheError(message: "Invalid row offset.") }
+        if rotating {
+            guard let cache = cache as? RotatingKVCache, cache.maxSize == capacity, cache.preservedPrefixTokens == 0 else { throw KVCacheError(message: "Sliding batch rows require one capacity and no pinned prefix.") }
+            let row = cache.logicalView(tail: capacity!)
+            rows.append(row?.0.dim(2) == 0 ? nil : row)
+        } else {
+            guard cache is KVCacheSimple else { throw KVCacheError(message: "Unsupported batch cache family.") }
+            let state = cache.state
+            rows.append(state.isEmpty || state[0].dim(2) == 0 ? nil : (state[0], state[1]))
+        }
+    }
+    let lengths = rows.map { $0?.0.dim(2) ?? 0 }
+    let width = lengths.max()!
+    let padding = lengths.map { width - $0 }
+    var result: any BatchKVCacheProtocol = rotating ? BatchRotatingKVCache(maxSize: capacity!, leftPadding: padding) : BatchKVCache(leftPadding: padding)
+    guard let prototype = rows.compactMap({ $0 }).first else { return result }
+    let k0 = prototype.0, v0 = prototype.1
+    var keys = MLXArray.zeros([caches.count, k0.dim(1), width, k0.dim(3)], dtype: k0.dtype)
+    var values = MLXArray.zeros([caches.count, v0.dim(1), width, v0.dim(3)], dtype: v0.dtype)
+    for (i, row) in rows.enumerated() {
+        guard let (k, v) = row else { continue }
+        guard k.ndim == 4 && v.ndim == 4 && k.dim(0) == 1 && v.dim(0) == 1 && k.dim(1) == k0.dim(1) && v.dim(1) == v0.dim(1) && k.dim(3) == k0.dim(3) && v.dim(3) == v0.dim(3) && k.dtype == k0.dtype && v.dtype == v0.dtype else { throw KVCacheError(message: "Batch K/V row layouts differ.") }
+        keys[i ..< i + 1, 0..., padding[i]..., 0...] = k
+        values[i ..< i + 1, 0..., padding[i]..., 0...] = v
+    }
+    result.state = [keys, values, MLXArray(caches.map { Int32($0.offset) }), MLXArray(padding.map(Int32.init))]
+    if let result = result as? BatchRotatingKVCache, let first = caches.first as? RotatingKVCache {
+        guard caches.allSatisfy({ ($0 as? RotatingKVCache)?.capacityOrigin == first.capacityOrigin }) else { throw KVCacheError(message: "Batch row capacity origins differ.") }
+        result.metaState = [String(capacity!), String(width), String(width), "false", first.capacityOrigin.rawValue]
+    }
+    return result
+}
