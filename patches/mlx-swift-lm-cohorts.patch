+// SPDX-License-Identifier: MIT
+// Batch padding and ring algorithms adapted from MIT-licensed mlx-lm/models/cache.py.
+// The existing dependency LICENSE retains the original Apple Inc. attribution.
+
+import Foundation
+import MLX
+
+/// Fixed-cohort caches retain an independent position and padding boundary per row.
+/// All mutation, extraction and evaluation belong to the model's existing producer.
+public protocol BatchKVCacheProtocol: BatchPositionedKVCache {
+    var batchSize: Int { get }
+    /// Existing producer only. Position arrays are actual cache state, not host
+    /// guesses; ready-only consumers may decline without evaluating them.
+    var rowPositionState: [MLXArray] { get }
+    func logicalOffset(row: Int) throws -> Int
+    func extract(row: Int, through position: Int) throws -> any KVCache
+    func extract(row: Int) throws -> any KVCache
+}
+
+private func rollRows(_ array: MLXArray, by shifts: MLXArray) -> MLXArray {
+    let count = array.dim(2)
+    guard count > 0 else { return array }
+    let positions = MLXArray(Int32(0) ..< Int32(count))[.newAxis, .newAxis, 0..., .newAxis]
+    let indices = (positions - shifts[0..., .newAxis, .newAxis, .newAxis]) % count
+    return takeAlong(array, indices, axis: 2)
+}
+
+private func checkBatchKV(_ keys: MLXArray, _ values: MLXArray, rows: Int) {
+    precondition(keys.ndim == 4 && values.ndim == 4)
+    precondition(keys.dim(0) == rows && values.dim(0) == rows)
+    precondition(keys.dim(1) == values.dim(1) && keys.dim(2) == values.dim(2))
+    precondition(keys.dim(2) > 0 && keys.dim(2) <= Int(Int32.max))
+}
+
+private func copyRow(_ array: MLXArray, row: Int, start: Int, end: Int) -> MLXArray {
+    // `take` lowers to Gather, which allocates out.nbytes() on CPU and Metal.
+    // Gathering on axis 0 also leaves the row output contiguous. Whole-slice
+    // assignment and contiguous(view) can return the original parent instead.
+    let interval = array[0..., 0..., start ..< end, 0...]
+    return take(interval, MLXArray([Int32(row)]), axis: 0)
+}
+
+private func copyBatchArray(_ array: MLXArray) -> MLXArray {
+    take(array, MLXArray(Int32(0) ..< Int32(array.dim(0))), axis: 0)
+}
+
+/// Full-attention cache. Cached prefixes are right-aligned; new suffixes are
+/// right-padded. `finalize()` moves that suffix padding to the left once.
+public final class BatchKVCache: BaseKVCache, BatchKVCacheProtocol {
+    public let batchSize: Int
+    public private(set) var batchOffset: MLXArray
+    private var leftPadding: MLXArray
+    private var ends: MLXArray?
+    private var keys: MLXArray?
+    private var values: MLXArray?
+    private let step = 256
+
+    public init(leftPadding: [Int]) {
+        precondition(!leftPadding.isEmpty && leftPadding.allSatisfy { (0 ... Int(Int32.max)).contains($0) })
+        batchSize = leftPadding.count
+        self.leftPadding = MLXArray(leftPadding.map(Int32.init))
+        batchOffset = -self.leftPadding
+        super.init()
+    }
+
+    public var rowPositionState: [MLXArray] { [batchOffset, leftPadding] }
+    public func logicalOffset(row: Int) throws -> Int {
+        guard (0..<batchSize).contains(row) else { throw KVCacheError(message: "Invalid cache row.") }
+        return batchOffset.asArray(Int.self)[row]
+    }
+    public override var ropeOffset: RoPEOffset { .batch(batchOffset + 0) }
+
+    public override func innerState() -> [MLXArray] {
+        [keys, values, batchOffset, leftPadding, ends].compactMap { $0 }
+    }
+
+    public override func prepare(lengths: [Int]?) {
+        guard let lengths else { return }
+        precondition(lengths.count == batchSize && lengths.allSatisfy { (0 ... Int(Int32.max)).contains($0) })
+        prepare(lengths: MLXArray(lengths.map(Int32.init)))
+    }
+
+    public override func prepare(lengths: MLXArray?) {
+        guard let lengths else { return }
+        precondition(lengths.shape == [batchSize] && ends == nil)
+        ends = batchOffset + lengths
+    }
+
+    public override func update(keys: MLXArray, values: MLXArray) -> (MLXArray, MLXArray) {
+        checkBatchKV(keys, values, rows: batchSize)
+        let previous = offset
+        let (next, overflow) = previous.addingReportingOverflow(keys.dim(2))
+        precondition(!overflow && next <= Int(Int32.max))
+        if self.keys == nil || next > self.keys!.dim(2) {
+            let capacity = ((keys.dim(2) + step - 1) / step) * step
+            let newKeys = MLXArray.zeros([batchSize, keys.dim(1), capacity, keys.dim(3)], dtype: keys.dtype)
+            let newValues = MLXArray.zeros([batchSize, values.dim(1), capacity, values.dim(3)], dtype: values.dtype)
+            if let oldKeys = self.keys, let oldValues = self.values {
+                self.keys = concatenated([oldKeys[.ellipsis, ..<previous, 0...], newKeys], axis: 2)
+                self.values = concatenated([oldValues[.ellipsis, ..<previous, 0...], newValues], axis: 2)
+            } else {
+                self.keys = newKeys
+                self.values = newValues
+            }
+        }
+        self.keys![.ellipsis, previous ..< next, 0...] = keys
+        self.values![.ellipsis, previous ..< next, 0...] = values
+        offset = next
+        batchOffset = batchOffset + keys.dim(2)
+        return (self.keys![.ellipsis, ..<offset, 0...], self.values![.ellipsis, ..<offset, 0...])
+    }
+
+    public override func finalize() {
+        guard let ends else { return }
+        let padding = maximum(batchOffset - ends, 0)
+        if let keys, let values {
+            self.keys = rollRows(keys[.ellipsis, ..<offset, 0...], by: padding)
+            self.values = rollRows(values[.ellipsis, ..<offset, 0...], by: padding)
+        }
+        batchOffset = batchOffset - padding
+        leftPadding = leftPadding + padding
+        self.ends = nil
+    }
+
+    public override func makeMask(n: Int, windowSize: Int?, returnArray: Bool) -> MLXFast.ScaledDotProductAttentionMaskMode {
+        let causal = createCausalMask(n: n, offset: offset, windowSize: windowSize)
+        let columns = MLXArray(Int32(0) ..< Int32(offset + n))[.newAxis, .newAxis, .newAxis, 0...]
+        return .array(causal & (columns .>= leftPadding[0..., .newAxis, .newAxis, .newAxis]))
+    }
+
+    public override var isTrimmable: Bool { true }
+    public override func trim(_ n: Int) -> Int {
+        let count = min(max(0, n), offset)
+        offset -= count
+        batchOffset = batchOffset - count
+        return count
+    }
+
+    public override var state: [MLXArray] {
+        get {
+            guard let keys, let values else { return [] }
+            return [keys[.ellipsis, ..<offset, 0...], values[.ellipsis, ..<offset, 0...], batchOffset, leftPadding]
+        }
+        set {
+            precondition(newValue.count == 4 && newValue[2].shape == [batchSize] && newValue[3].shape == [batchSize])
+            checkBatchKV(newValue[0], newValue[1], rows: batchSize)
+            keys = newValue[0]; values = newValue[1]
+            offset = newValue[0].dim(2); batchOffset = newValue[2]; leftPadding = newValue[3]
+            ends = nil
+        }
+    }
+
+    public override func copy() -> any KVCache {
+        let result = BatchKVCache(leftPadding: Array(repeating: 0, count: batchSize))
+        result.keys = keys.map(copyBatchArray); result.values = values.map(copyBatchArray)
+        result.offset = offset; result.batchOffset = batchOffset + 0
+        result.leftPadding = leftPadding + 0; result.ends = ends.map { $0 + 0 }
+        return result
+    }
+
+    public func extract(row: Int) throws -> any KVCache {
+        try extract(row: row, through: logicalOffset(row: row))
+    }
+    public func extract(row: Int, through position: Int) throws -> any KVCache {
+        let actual = try logicalOffset(row: row)
+        guard ends == nil, position >= 0, position <= actual else {
+            throw KVCacheError(message: "Extract a finalized known row prefix.")
+        }
+        let result = KVCacheSimple()
+        guard position > 0, let keys, let values else { return result }
+        let padding = leftPadding.asArray(Int.self)[row]
+        guard (0 ... offset).contains(padding), position <= offset - padding else {
+            throw KVCacheError(message: "Invalid batch padding.")
+        }
+        // The exact prefix excludes peers' later inert inputs. The raw copy
+        // retains its shared parent through the existing evaluation/join fence.
+        result.state = [copyRow(keys, row: row, start: padding, end: padding + position),
+            copyRow(values, row: row, start: padding, end: padding + position)]
+        return result
+    }
+}
