--- a/mlx/c/array.cpp
+++ b/mlx/c/array.cpp
@@ -6,6 +6,83 @@
 #include "mlx/c/error.h"
 #include "mlx/c/private/mlx.h"
 #include "mlx/c/string.h"
+
+namespace {
+struct ReadyBuffer {
+  std::shared_ptr<mlx::core::array::Data> storage;
+  const void* bytes;
+  size_t size;
+  size_t offset;
+};
+} // namespace
+
+extern "C" int mlx_array_try_ready_buffer(
+    mlx_ready_buffer* result, const mlx_array arr) {
+  if (result == nullptr) {
+    return 1;
+  }
+  result->ctx = nullptr;
+#if defined(_METAL_)
+  try {
+    auto& value = mlx_array_get_(arr);
+    // is_available alone accepts evaluated intermediates without an event.
+    if (value.status() == mlx::core::array::Status::unscheduled) {
+      return 1;
+    }
+    if (value.event().valid()) {
+      if (!value.event().is_signaled()) {
+        return 1;
+      }
+      // Observe without consuming the original producer error.
+      if (value.event().load_error() != nullptr) {
+        return 1;
+      }
+    } else if (value.status() != mlx::core::array::Status::available) {
+      return 1;
+    }
+    // Do not detach the event or change producer status during handoff.
+    if (value.size() == 0 ||
+        !value.data_shared_ptr() || value.offset() < 0) {
+      return 1;
+    }
+    // Data only: no ArrayDesc, primitive, inputs, graph or event crosses threads.
+    auto storage = value.data_shared_ptr();
+    // External managed/no-op weak Data can alias an unpinned allocation or
+    // carry a thread-confined finalizer. Only MLX allocator ownership is safe.
+    auto* deleter = storage->d.target<decltype(&mlx::core::allocator::free)>();
+    if (deleter == nullptr || *deleter != &mlx::core::allocator::free) {
+      return 1;
+    }
+    auto size = value.buffer_size();
+    auto offset = static_cast<size_t>(value.offset());
+    auto bytes = storage->buffer.raw_ptr();
+    if (bytes == nullptr || offset >= size) {
+      return 1;
+    }
+    result->ctx = new ReadyBuffer{std::move(storage), bytes, size, offset};
+    return 0;
+  } catch (...) {
+    // Optimization failure must not call the process-wide fatal error handler.
+    return 1;
+  }
+#else
+  // Other raw_ptr backends can perform synchronous device transfers.
+  return 1;
+#endif
+}
+
+extern "C" void mlx_ready_buffer_free(mlx_ready_buffer buffer) {
+  delete static_cast<ReadyBuffer*>(buffer.ctx);
+}
+extern "C" const void* mlx_ready_buffer_data(mlx_ready_buffer buffer) {
+  return buffer.ctx ? static_cast<ReadyBuffer*>(buffer.ctx)->bytes : nullptr;
+}
+extern "C" size_t mlx_ready_buffer_size(mlx_ready_buffer buffer) {
+  return buffer.ctx ? static_cast<ReadyBuffer*>(buffer.ctx)->size : 0;
+}
+extern "C" size_t mlx_ready_buffer_offset(mlx_ready_buffer buffer) {
+  return buffer.ctx ? static_cast<ReadyBuffer*>(buffer.ctx)->offset : 0;
+}
 
