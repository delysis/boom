diff --git a/Core/Sources/BoomCore/TextInputLimit.swift b/Core/Sources/BoomCore/TextInputLimit.swift
new file mode 100644
index 0000000..212f65a
--- /dev/null
+++ b/Core/Sources/BoomCore/TextInputLimit.swift
@@ -0,0 +1,31 @@
+import Foundation
+
+/// AppKit may hand us an NSString-backed String. Range(_:in:) alone can accept
+/// half of a surrogate pair on that representation. Validate its UTF-16 code
+/// units before bridging any selected substring. Combining marks remain native
+/// editable scalars; this gate does not break IME replacement inside a grapheme.
+public enum TextInputLimit {
+  public static func validateReplacement(in text: String, range: NSRange,
+    replacement: String, maximumUTF8Bytes: Int) throws {
+    let source = text as NSString
+    guard maximumUTF8Bytes >= 0, range.location >= 0, range.length >= 0,
+      range.location <= source.length, range.length <= source.length - range.location else {
+      throw BoomError.invalid("The text replacement is outside the input.")
+    }
+    func scalarBoundary(_ offset: Int) -> Bool {
+      guard offset > 0, offset < source.length else { return true }
+      return !(0xD800...0xDBFF).contains(source.character(at: offset - 1))
+        || !(0xDC00...0xDFFF).contains(source.character(at: offset))
+    }
+    guard scalarBoundary(range.location), scalarBoundary(range.location + range.length) else {
+      throw BoomError.invalid("The text replacement splits a Unicode scalar.")
+    }
+    let removed = source.substring(with: range).utf8.count
+    let existing = text.utf8.count
+    guard removed <= existing else { throw BoomError.invalid("The input encoding changed.") }
+    let retained = existing - removed
+    guard retained <= maximumUTF8Bytes, replacement.utf8.count <= maximumUTF8Bytes - retained else {
+      throw BoomError.budget("The message exceeds its input limit. Nothing was pasted or truncated.")
+    }
+  }
+}
diff --git a/Core/Tests/BoomCoreTests/TextInputLimitTests.swift b/Core/Tests/BoomCoreTests/TextInputLimitTests.swift
new file mode 100644
index 0000000..9225b88
--- /dev/null
+++ b/Core/Tests/BoomCoreTests/TextInputLimitTests.swift
@@ -0,0 +1,32 @@
+import Foundation
+import XCTest
+@testable import BoomCore
+
+final class TextInputLimitTests: XCTestCase {
+  func testEveryUTF16BoundaryIncludingNSStringBackedInput() throws {
+    let inputs = ["🪶e\u{301}", String(NSString(string: "🪶e\u{301}")), "a👩‍👩‍👧‍👧z", "", "a\r\nb"]
+    for text in inputs {
+      let units = Array(text.utf16)
+      func valid(_ i: Int) -> Bool {
+        i == 0 || i == units.count || !(0xD800...0xDBFF).contains(units[i - 1]) || !(0xDC00...0xDFFF).contains(units[i])
+      }
+      for start in 0...units.count {
+        for end in start...units.count {
+          let result = Result { try TextInputLimit.validateReplacement(in: text,
+            range: NSRange(location: start, length: end - start), replacement: "x", maximumUTF8Bytes: Int.max) }
+          if valid(start) && valid(end) { XCTAssertNoThrow(try result.get(), "\(start)..<\(end) in \(text)") }
+          else { XCTAssertThrowsError(try result.get()) }
+        }
+      }
+    }
+  }
+  func testBoundsAreCheckedWithoutOverflowAndDeletingCanRecoverAnOverlimitInput() throws {
+    let text = "🪶e\u{301}", count = text.utf8.count
+    XCTAssertThrowsError(try TextInputLimit.validateReplacement(in: text, range: NSRange(location: 4, length: 0), replacement: "a", maximumUTF8Bytes: count))
+    try TextInputLimit.validateReplacement(in: text, range: NSRange(location: 0, length: 2), replacement: "a", maximumUTF8Bytes: count - 3)
+    for range in [NSRange(location: -1, length: 0), NSRange(location: 0, length: -1), NSRange(location: Int.max, length: 1), NSRange(location: 2, length: Int.max)] {
+      XCTAssertThrowsError(try TextInputLimit.validateReplacement(in: text, range: range, replacement: "", maximumUTF8Bytes: Int.max))
+    }
+    XCTAssertThrowsError(try TextInputLimit.validateReplacement(in: "", range: NSRange(location: 0, length: 0), replacement: "", maximumUTF8Bytes: -1))
+  }
+}
